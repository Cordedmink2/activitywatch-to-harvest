# Windows sets core.autocrlf=true by default. Without these rules a clone there
# rewrites the shell scripts with CRLF endings and bash fails on the shebang's
# trailing \r before it runs a single line.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.ps1  text eol=crlf

VERSION text eol=lf
LICENSE text eol=lf
