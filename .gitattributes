# Windows sets core.autocrlf=true by default. Without these rules a clone there
# rewrites the shell scripts with CRLF endings and bash fails on the shebang's
# trailing \r before it runs a line. LF for everything, so a new file type can't
# reintroduce that; PowerShell is the one platform-native exception.
* text=auto eol=lf

*.ps1 text eol=crlf
