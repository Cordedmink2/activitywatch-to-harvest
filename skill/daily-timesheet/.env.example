# Harvest API credentials for the daily-timesheet skill.
#
# Copy this file to `.env` (same folder) and fill in your values.
#
# SECURITY: never commit `.env` to git and never share the skill folder
# with `.env` included — the API key grants full access to your Harvest
# account. The sibling `.gitignore` covers git, but if you zip the skill
# to share with a coworker, remove `.env` first.
#
# Find both values at https://id.getharvest.com/developers:
#   HARVEST_ACCOUNT_ID  — your numeric account ID (top of the developer page)
#   HARVEST_API_KEY     — a personal access token you create on that page

HARVEST_ACCOUNT_ID=
HARVEST_API_KEY=
